{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.example/schemas/m365-declarative-agent-designer/design-result-0.1.0.schema.json",
  "title": "M365 Declarative Agent Designer DesignResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "result_id",
    "request_id",
    "request_digest",
    "generated_on",
    "status",
    "human_review_required",
    "disclaimers",
    "modes",
    "requirements",
    "findings",
    "provenance",
    "contradictions",
    "abstentions",
    "carry_forward",
    "evaluation_metadata"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "result_id": {
      "type": "string",
      "pattern": "^DRS-[A-Z0-9._-]{1,60}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^DRQ-[A-Z0-9._-]{1,60}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generated_on": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "Complete",
        "Open",
        "Rejected"
      ]
    },
    "human_review_required": {
      "const": true
    },
    "disclaimers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "microsoft_runtime_artifact",
        "deployment_approval",
        "tenant_fitment_evidence",
        "runtime_compatibility_proof"
      ],
      "properties": {
        "microsoft_runtime_artifact": {
          "const": false
        },
        "deployment_approval": {
          "const": false
        },
        "tenant_fitment_evidence": {
          "const": false
        },
        "runtime_compatibility_proof": {
          "const": false
        }
      }
    },
    "modes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "$ref": "#/$defs/discoveryMode"
        },
        {
          "$ref": "#/$defs/elicitationMode"
        },
        {
          "$ref": "#/$defs/conceptualisationMode"
        },
        {
          "$ref": "#/$defs/authoringMode"
        },
        {
          "$ref": "#/$defs/assuranceMode"
        }
      ],
      "items": false
    },
    "requirements": {
      "$ref": "#/$defs/requirements"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "finding-provenance-0.1.0.schema.json#/$defs/finding"
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "finding-provenance-0.1.0.schema.json#/$defs/provenance"
      }
    },
    "contradictions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "finding-provenance-0.1.0.schema.json#/$defs/contradiction"
      }
    },
    "abstentions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "finding-provenance-0.1.0.schema.json#/$defs/abstention"
      }
    },
    "carry_forward": {
      "$ref": "finding-provenance-0.1.0.schema.json#/$defs/carryForward"
    },
    "evaluation_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "fixture_id",
        "adapter_id",
        "validator_outcome",
        "finding_codes",
        "duration_ms",
        "correlation_id"
      ],
      "properties": {
        "contract_version": {
          "const": "0.1.0"
        },
        "fixture_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "adapter_id": {
          "enum": [
            "codex",
            "chatgpt-work",
            "canonical"
          ]
        },
        "validator_outcome": {
          "enum": [
            "passed",
            "failed",
            "abstained"
          ]
        },
        "finding_codes": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^DAD-[A-Z0-9-]{2,80}$"
          }
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^SYN-[A-Z0-9._-]{1,80}$"
        }
      }
    }
  },
  "$defs": {
    "modeBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "summary",
        "finding_ids"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "finding_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^FND-[A-Z0-9._-]{1,60}$"
          }
        }
      }
    },
    "discoveryMode": {
      "allOf": [
        {
          "$ref": "#/$defs/modeBase"
        },
        {
          "properties": {
            "mode": {
              "const": "Discovery"
            }
          }
        }
      ]
    },
    "elicitationMode": {
      "allOf": [
        {
          "$ref": "#/$defs/modeBase"
        },
        {
          "properties": {
            "mode": {
              "const": "Elicitation"
            }
          }
        }
      ]
    },
    "conceptualisationMode": {
      "allOf": [
        {
          "$ref": "#/$defs/modeBase"
        },
        {
          "properties": {
            "mode": {
              "const": "Conceptualisation"
            }
          }
        }
      ]
    },
    "authoringMode": {
      "allOf": [
        {
          "$ref": "#/$defs/modeBase"
        },
        {
          "properties": {
            "mode": {
              "const": "Authoring"
            }
          }
        }
      ]
    },
    "assuranceMode": {
      "allOf": [
        {
          "$ref": "#/$defs/modeBase"
        },
        {
          "properties": {
            "mode": {
              "const": "Assurance"
            }
          }
        }
      ]
    },
    "boundedList": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actors",
        "scope",
        "exclusions",
        "functional_needs",
        "nonfunctional_needs",
        "data",
        "integrations",
        "security",
        "open_questions"
      ],
      "properties": {
        "actors": {
          "$ref": "#/$defs/boundedList"
        },
        "scope": {
          "$ref": "#/$defs/boundedList"
        },
        "exclusions": {
          "$ref": "#/$defs/boundedList"
        },
        "functional_needs": {
          "$ref": "#/$defs/boundedList"
        },
        "nonfunctional_needs": {
          "$ref": "#/$defs/boundedList"
        },
        "data": {
          "$ref": "#/$defs/boundedList"
        },
        "integrations": {
          "$ref": "#/$defs/boundedList"
        },
        "security": {
          "$ref": "#/$defs/boundedList"
        },
        "open_questions": {
          "$ref": "#/$defs/boundedList"
        }
      }
    }
  }
}
