{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:power-platform-learning-lab:dataverse-webapi-query:answer:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_type",
    "status",
    "recommendation",
    "assumptions",
    "resolved_schema",
    "unresolved_schema",
    "host_context",
    "query_or_code",
    "security_notes",
    "sources_or_reference_basis",
    "open_questions"
  ],
  "properties": {
    "result_type": {
      "enum": ["success", "abstention", "unsupported_request", "security_refusal"]
    },
    "status": {"enum": ["Resolved", "Open", "Unsupported", "Refused"]},
    "recommendation": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "resolved_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_logical_name",
        "entity_set_name",
        "attribute_logical_names",
        "lookup_annotation_columns",
        "navigation_properties",
        "choice_or_status_values",
        "generated_service_name",
        "host_api_contract"
      ],
      "properties": {
        "table_logical_name": {"type": ["string", "null"]},
        "entity_set_name": {"type": ["string", "null"]},
        "attribute_logical_names": {"type": "array", "items": {"type": "string"}},
        "lookup_annotation_columns": {"type": "array", "items": {"type": "string"}},
        "navigation_properties": {"type": "array", "items": {"type": "string"}},
        "choice_or_status_values": {"type": "array", "items": {"type": "string"}},
        "generated_service_name": {"type": ["string", "null"]},
        "host_api_contract": {"type": ["string", "null"]}
      }
    },
    "unresolved_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact", "reason", "required_confirmation"],
        "properties": {
          "fact": {
            "enum": [
              "table_logical_name",
              "entity_set_name",
              "attribute_logical_name",
              "lookup_annotation_column",
              "navigation_property",
              "choice_or_status_value",
              "generated_service_name",
              "host_api_contract",
              "source_currency",
              "reference_detail"
            ]
          },
          "reason": {"type": "string", "minLength": 1},
          "required_confirmation": {"type": "string", "minLength": 1}
        }
      }
    },
    "host_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "selected", "supported_options", "required_clarification"],
      "properties": {
        "status": {"enum": ["resolved", "unresolved", "not_applicable"]},
        "selected": {
          "type": ["string", "null"],
          "enum": [
            "host_neutral_odata",
            "raw_web_api",
            "xrm_webapi",
            "generative_page_dataapi",
            "code_app_generated_service",
            "canvas_power_fx",
            "power_automate_list_rows",
            "not_applicable",
            null
          ]
        },
        "supported_options": {"type": "array", "items": {"type": "string"}},
        "required_clarification": {"type": ["string", "null"]}
      }
    },
    "query_or_code": {"type": "string"},
    "security_notes": {"type": "array", "items": {"type": "string"}},
    "sources_or_reference_basis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "pin", "availability", "use"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "pin": {"type": ["string", "null"]},
          "availability": {"enum": ["available", "missing", "not_applicable"]},
          "use": {"type": "string", "minLength": 1}
        }
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"required": ["result_type"], "properties": {"result_type": {"const": "success"}}},
      "then": {
        "properties": {
          "status": {"const": "Resolved"},
          "unresolved_schema": {"maxItems": 0},
          "host_context": {
            "properties": {
              "status": {"const": "resolved"},
              "selected": {"not": {"type": "null"}}
            }
          },
          "query_or_code": {"minLength": 1}
        }
      }
    },
    {
      "if": {"required": ["result_type"], "properties": {"result_type": {"const": "abstention"}}},
      "then": {
        "properties": {
          "status": {"const": "Open"},
          "unresolved_schema": {"minItems": 1},
          "query_or_code": {"maxLength": 0}
        }
      }
    },
    {
      "if": {"required": ["result_type"], "properties": {"result_type": {"const": "unsupported_request"}}},
      "then": {
        "properties": {
          "status": {"const": "Unsupported"},
          "query_or_code": {"maxLength": 0}
        }
      }
    },
    {
      "if": {"required": ["result_type"], "properties": {"result_type": {"const": "security_refusal"}}},
      "then": {
        "properties": {
          "status": {"const": "Refused"},
          "query_or_code": {"maxLength": 0},
          "security_notes": {"minItems": 1}
        }
      }
    },
    {
      "if": {"required": ["unresolved_schema"], "properties": {"unresolved_schema": {"minItems": 1}}},
      "then": {"properties": {"query_or_code": {"maxLength": 0}}}
    }
  ]
}
