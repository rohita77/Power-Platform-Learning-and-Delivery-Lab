{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.example/schemas/m365-declarative-agent-designer/finding-provenance-0.1.0.schema.json",
  "title": "M365 Declarative Agent Designer shared finding and provenance contract",
  "$defs": {
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "sourceReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(PRV-[A-Z0-9._-]{1,60}|EV-[A-Z0-9._-]{1,60}|synthetic:[A-Za-z0-9._/-]{1,480})$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_type",
        "title",
        "reference",
        "status",
        "verified_on",
        "revalidate_on"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PRV-[A-Z0-9._-]{1,60}$"
        },
        "source_type": {
          "enum": [
            "public-first-party",
            "synthetic-fixture",
            "preserved-evidence"
          ]
        },
        "title": {
          "$ref": "#/$defs/boundedText"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "status": {
          "enum": [
            "current",
            "expired",
            "unknown"
          ]
        },
        "verified_on": {
          "type": "string",
          "format": "date"
        },
        "revalidate_on": {
          "type": "string",
          "format": "date"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "severity",
        "statement",
        "evidence_label",
        "provenance_ids",
        "affected_paths",
        "resolution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FND-[A-Z0-9._-]{1,60}$"
        },
        "category": {
          "enum": [
            "requirement",
            "boundary",
            "product-claim",
            "provenance",
            "contradiction",
            "abstention",
            "portability",
            "lineage",
            "assurance"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "statement": {
          "$ref": "#/$defs/boundedText"
        },
        "evidence_label": {
          "enum": [
            "Confirmed",
            "Assumption",
            "Recommendation",
            "Inference",
            "Open",
            "Superseded"
          ]
        },
        "provenance_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^PRV-[A-Z0-9._-]{1,60}$"
          }
        },
        "affected_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^/"
          }
        },
        "resolution": {
          "enum": [
            "accepted",
            "human-review",
            "open",
            "rejected",
            "superseded"
          ]
        }
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "finding_ids",
        "status",
        "resolution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CON-[A-Z0-9._-]{1,60}$"
        },
        "statement": {
          "$ref": "#/$defs/boundedText"
        },
        "finding_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^FND-[A-Z0-9._-]{1,60}$"
          }
        },
        "status": {
          "enum": [
            "unresolved",
            "resolved"
          ]
        },
        "resolution": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "abstention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "claim",
        "reason",
        "finding_ids",
        "provenance_ids",
        "contradiction_ids",
        "human_action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ABS-[A-Z0-9._-]{1,60}$"
        },
        "claim": {
          "$ref": "#/$defs/boundedText"
        },
        "reason": {
          "enum": [
            "absent-evidence",
            "contradictory-evidence",
            "stale-evidence",
            "unsupported-claim",
            "prohibited-boundary"
          ]
        },
        "finding_ids": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^FND-[A-Z0-9._-]{1,60}$"
          }
        },
        "provenance_ids": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^PRV-[A-Z0-9._-]{1,60}$"
          }
        },
        "contradiction_ids": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CON-[A-Z0-9._-]{1,60}$"
          }
        },
        "human_action": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "positionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(DEC|ASM|OPN|REJ|SUP)-[A-Z0-9._-]{1,60}$"
        },
        "statement": {
          "$ref": "#/$defs/boundedText"
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        }
      }
    },
    "carryForward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "state_id",
        "sequence",
        "previous_result_id",
        "request_ids",
        "result_ids",
        "confirmed_decisions",
        "assumptions",
        "open_items",
        "rejected_decisions",
        "superseded_chronology",
        "evidence_refs"
      ],
      "properties": {
        "contract_version": {
          "const": "0.1.0"
        },
        "state_id": {
          "type": "string",
          "pattern": "^STATE-[A-Z0-9._-]{1,60}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "previous_result_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^DRS-[A-Z0-9._-]{1,60}$"
        },
        "request_ids": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^DRQ-[A-Z0-9._-]{1,60}$"
          }
        },
        "result_ids": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^DRS-[A-Z0-9._-]{1,60}$"
          }
        },
        "confirmed_decisions": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/positionItem"
          }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/positionItem"
          }
        },
        "open_items": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/positionItem"
          }
        },
        "rejected_decisions": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/positionItem"
          }
        },
        "superseded_chronology": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/positionItem"
          }
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 500,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        }
      }
    }
  }
}
